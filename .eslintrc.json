{
  "root": true,
  "parser": "@babel/eslint-parser",
  "parserOptions": {
    "requireConfigFile": false
  },
  "extends": ["@amzn/eslint-config-lilax-style/lint-js"],
  "globals": {
    "globalThis": "readonly",
    "globalConnect": "writable",
    "connect": "writable"
  },
  "rules": {
    "wrap-iife": ["error", "inside"],
    "consistent-return": "off",
    "func-names": "off",
    "max-len": "off",
    "no-console": "off",
    "no-underscore-dangle": "off",
    "global-require": "off"
  }
}
